# SMTP-Zugang für das Termin-Formular (app/api/termin/route.ts).
# Diese Datei als .env.local kopieren und ausfüllen. .env.local nie einchecken.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Absenderadresse der Mails, muss zum SMTP-Konto passen
SMTP_FROM=
# Empfängeradresse der Praxis
PRAXIS_MAIL=

# Google-Bewertungen auf der Startseite (components/GoogleBewertungen).
# Der Schlüssel wird nur auf dem Server benutzt und darf nie in den Browser.
# Die Place ID ist öffentlich (Präfix NEXT_PUBLIC_ ist deshalb unkritisch).
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_PLACE_ID=
