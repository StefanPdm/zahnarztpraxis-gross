# SMTP-Zugang für das Termin- und das Bewerbungsformular
# (app/api/termin/route.ts, app/api/bewerbung/route.ts).
# Diese Datei als .env.local kopieren und ausfüllen. .env.local nie einchecken.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Absenderadresse der Mails, muss zum SMTP-Konto passen
SMTP_FROM=
# Empfängeradresse der Praxis
PRAXIS_MAIL=
# Optional: Info an den Admin bei jedem abgeschickten Formular — nur Art,
# Zeitpunkt und Versandergebnis, keine Formularinhalte (lib/adminmeldung.ts).
# Leer lassen = keine Info-Mail.
ADMIN_MAIL=

# Google-Bewertungen auf der Startseite (components/GoogleBewertungen).
# Der Schlüssel wird nur auf dem Server benutzt und darf nie in den Browser.
# Die Place ID der Praxis steht als Stammdatum in lib/praxis.ts, nicht hier:
# Netlify prüft die Werte aller Umgebungsvariablen gegen das Build-Ergebnis
# und bricht ab, wenn einer darin auftaucht — die Place ID tut das zwangsläufig.
GOOGLE_PLACES_API_KEY=
